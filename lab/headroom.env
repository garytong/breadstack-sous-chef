# Local Sous Chef service for the HEADROOM measurement: the same binary that
# runs on int, pointed at the workstation's lab Ollama (127.0.0.1:11435,
# Ollama 0.34.4, speaks Anthropic /v1/messages) instead of Claude. No API
# spend. Used by `make -C lab headroom` after a Claude collection exists.
#
#   docker compose up -d --wait postgres          # repo root, Postgres on :5433
#   go run ./service/cmd/sous-chef -migrate        # with this env (or make build)
#   set -a; . lab/headroom.env; set +a; setsid nohup ./service/bin/sous-chef >> /tmp/souschef-headroom.log 2>&1 < /dev/null &
#   (detached: an eval of 76 cases × 8 outlasts a 2-hour agent task slot, and the
#   service must not die with it — measured 2026-10-04, one eval lost)
#   souschef-lab eval --url http://127.0.0.1:8091 --key local-headroom-key --route qwen9b …
#
PORT=8091
DATABASE_URL=postgres://souschef:souschef@localhost:5433/souschef_headroom?sslmode=disable
MIGRATE_AT_BOOT=on
SERVICE_KEYS=local-headroom-key
BUILD_ID=headroom

# No Anthropic route at all, so no key is needed. Routes speak the Anthropic
# Messages shape to Ollama; `stream:false` because Ollama's streaming frames
# differ. The *-ctx64k tags carry num_ctx 65536 (the prompt prefix alone is
# ~11k tokens of manifest index + ~26 KB of tools).
MODEL_ROUTES='{"qwen9b":{"kind":"messages-compatible","url":"http://127.0.0.1:11435","auth":"none","model":"qwen3.5:9b-ctx64k","max_tokens":4096,"stream":false},"qwen27b":{"kind":"messages-compatible","url":"http://127.0.0.1:11435","auth":"none","model":"qwen3.8:27b-ctx64k","max_tokens":4096,"stream":false},"gemma31b":{"kind":"messages-compatible","url":"http://127.0.0.1:11435","auth":"none","model":"gemma4:31b-qat-ctx64k","max_tokens":4096,"stream":false}}'
DEFAULT_ROUTE=qwen9b
MODEL_ROUTE_ALLOWLIST=qwen9b,qwen27b,gemma31b
MODEL_CALL_TIMEOUT=180s
TURN_TTL=15m
MAX_CONCURRENT_TURNS=2
TRACE_RETENTION_DAYS=90
