# Sous Chef service configuration (README §7). Copy to .env for `make run`.
# .env is git-ignored; never commit real keys.

# Listen port.
PORT=8090

# pgx DSN. Local docker-compose Postgres (make db-up) listens on 5433.
# Cloud Run uses the Cloud SQL socket: postgres://user:pass@/souschef?host=/cloudsql/<connection-name>
DATABASE_URL=postgres://souschef:souschef@localhost:5433/souschef?sslmode=disable

# on | off — run migrations before listening (Cloud Run uses the migrate job instead).
MIGRATE_AT_BOOT=off

# Comma-separated bearer keys the launcher presents (two during rotation).
# Generate one with: openssl rand -hex 32
SERVICE_KEYS=replace-me-local-dev-key

# Required for `anthropic` routes.
ANTHROPIC_API_KEY=
# Endpoint override; the e2e tests point this at the fake model.
ANTHROPIC_BASE_URL=

# Route table (JSON). Leave unset for the README §5 default:
#   default → claude-sonnet-5-5, opus → claude-opus-5-5 (both effort=medium, max_tokens=8192).
# Example adding an in-house endpoint that speaks /v1/messages. Messages-compatible
# routes also take "thinking":"disabled"|"enabled" (default disabled: the body carries
# {"thinking":{"type":"disabled"}} and stored thinking blocks are dropped from the
# re-sent history — what the SFT adapter was trained on), "temperature" (0..2) and
# "top_p" (0..1), sent only when set. Anthropic routes reject all three (adaptive thinking).
# Any route takes "fields_context":"on"|"off": the turn's candidate-fields block (targets +
# field keys the merchant's text matches, README §3) in the user message. Unset = on for
# messages-compatible routes, off for anthropic routes (their requests are unchanged).
# Hybrid: "fallback":"<route>" on a route sends a turn's NEXT model call to that route, at most
# once per turn, when this route's model fails it (an op refused, report_unsupported, a model
# error/timeout, max_tokens; README §4 "Hybrid"). The fallback must be another route with no
# fallback of its own; it need not be allowlisted. e.g.
#   "blueberry-muffin":{"kind":"messages-compatible","url":"…","auth":"none","model":"sous-chef","max_tokens":4096,"fallback":"default","report_as":"blueberry-muffin"}
# "report_as":"<id>" (any route; a plain token [a-z0-9][a-z0-9._-]*, max 64) is the model id the
# route's calls are reported under: every usage row (the thermometer), the trace and turn.done
# carry it instead of the id the backend echoes (Ollama: its tag). The id must be on the
# thermometer's rate card at $0 (its server/internal/therm/pricing.go — not this repo's file).
# The route NAME is free: nothing keys on it. README §5.
# MODEL_ROUTES={"default":{"kind":"anthropic","auth":"api-key","model":"claude-sonnet-5-5","max_tokens":8192,"effort":"medium"},"local":{"kind":"messages-compatible","url":"https://gpu.internal/v1/messages","auth":"id-token","model":"qwen3","max_tokens":4096,"stream":false,"thinking":"disabled","temperature":0.2}}
MODEL_ROUTES=
DEFAULT_ROUTE=default
MODEL_ROUTE_ALLOWLIST=default,opus

# Per model call.
MODEL_CALL_TIMEOUT=60s
# Lifetime of a turn waiting for tool results / suspended on pick_asset.
TURN_TTL=10m
# Per instance; beyond this POST /v1/turns answers 503 busy.
MAX_CONCURRENT_TURNS=8
# Trace retention for the daily job.
TRACE_RETENTION_DAYS=90

# Usage shipping to the thermometer (both or neither).
THERMOMETER_API_URL=
THERMOMETER_API_KEY=

# Reported by /version; the Makefile bakes the git sha in via -ldflags when unset.
BUILD_ID=dev
